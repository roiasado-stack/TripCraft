        "jsCode": "const trip = $json;\nconst SUPABASE_URL = \"https://fclfhzuqlvdelcsrroql.supabase.co\";\nconst SERVICE_KEY = \"eyJhbGci•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••\";\nconst headers = { apikey: SERVICE_KEY, Authorization: `Bearer ${SERVICE_KEY}` };\n\ntry {\n  const participants = await this.helpers.httpRequest({\n    method: \"GET\",\n    url: `${SUPABASE_URL}/rest/v1/participants?trip_id=eq.${trip.id}&select=name,age,age_range,preferences`,\n    headers,\n    json: true,\n  });\n  return { json: { ok: true, participants } };\n} catch (e) {\n  return {\n    json: {\n      ok: false,\n      message: e.message,\n      httpCode: e.httpCode || null,\n      cause_status: e.cause?.response?.status || null,\n      cause_data: e.cause?.response?.data || null,\n      full: JSON.parse(JSON.stringify(e, Object.getOwnPropertyNames(e))),\n    },\n  };\n}"
      },
