# Copy this file to .env and fill in your Supabase project details.
# Project Settings → API in the Supabase dashboard.

VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Web push (optional): the VAPID *public* key, the same value as the notify
# function's VAPID_PUBLIC_KEY secret. Leave empty to hide the notifications button.
VITE_VAPID_PUBLIC_KEY=""

# Landing-page analytics (optional). Empty = nothing is loaded and nothing is sent.
# They run only on the landing page, /agents, the new-trip wizard and the "trip created"
# screen (src/lib/analytics.ts), and /privacy mentions them only when one of these is set.
# In GA4 also switch OFF Enhanced measurement -> "Page changes based on browser history events".
VITE_GA_ID=""
VITE_META_PIXEL_ID=""
