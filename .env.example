# Copy this file to .env and fill in your Supabase project details.
# Project Settings → API in the Supabase dashboard.

VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Web push (optional): the VAPID *public* key, the same value as the notify
# function's VAPID_PUBLIC_KEY secret. Leave empty to hide the notifications button.
VITE_VAPID_PUBLIC_KEY=""
