    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const trip = $('שליפת טיולים').item.json;\nconst participants = $('איסוף משתתפים').item.json.data || [];\nconst flights = $('איסוף טיסות').item.json.data || [];\nconst owner = $json; // הפלט של node \"שליפת מייל\"\n\nconst items = new Set([\n  \"דרכונים בתוקף (6+ חודשים)\", \"כרטיסי טיסה / אישורי הזמנה\", \"ביטוח נסיעות\",\n  \"מטען וכבלים לטלפון\", \"מתאם חשמל בינלאומי\", \"כסף מזומן + כרטיס אשראי\",\n  \"תרופות אישיות\", \"משקפי שמש וקרם הגנה\",\n]);\n\nconst ages = participants.map(p => p.age ?? (p.age_range ? parseInt(p.age_range) : null)).filter(a => a != null);\nif (ages.some(a => a <= 3)) [\"חיתולים ומגבונים\", \"אוכל/תחליף לתינוק\", \"עגלה או מנשא\", \"בגדים להחלפה בשפע\"].forEach(i => items.add(i));\nif (ages.some(a => a > 3 && a <= 12)) [\"צעצועים / פעילות לילדים\", \"חטיפים לדרך\", \"בגדי החלפה לילדים\"].forEach(i => items.add(i));\n\nconst prefs = new Set(participants.flatMap(p => p.preferences || []));\nif (prefs.has(\"beach\")) [\"בגדי ים\", \"מגבת חוף\", \"כפכפים\"].forEach(i => items.add(i));\nif (prefs.has(\"sport\")) [\"נעלי ספורט\", \"בגדי אימון\"].forEach(i => items.add(i));\nif (prefs.has(\"history\")) items.add(\"נעליים נוחות להליכה\");\nif (prefs.has(\"accessibility\")) items.add(\"ציוד נגישות / עזרים\");\n\nconst outbound = flights.find(f => f.direction === \"outbound\") || null;\nif (outbound?.depart_at) items.add(`צ'ק-אין אונליין (${outbound.airline || \"\"} ${outbound.flight_number || \"\"})`);\n\nconst checklist = [...items];\nconst emailHtml = `<div dir=\"rtl\" style=\"direction:rtl; text-align:right; font-family:Arial,sans-serif; font-size:15px; line-height:1.6;\">\n  <p>שלום,</p>\n  <p>הטיול שלך ל<strong>${trip.destination}</strong> יוצא בעוד שבוע (${trip.start_date})!</p>\n  <p>רשימת פרה-פלייט:</p>\n  <ul>${checklist.map(i => `<li>${i}</li>`).join(\"\")}</ul>\n  <p>נסיעה טובה!<br>TripCraft</p>\n</div>`;\n\nreturn { json: { ...trip, owner_email: owner.email, checklist, emailHtml } };"
      },
